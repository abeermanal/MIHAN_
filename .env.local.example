# Supabase — انسخي هذا الملف إلى .env.local واملئي القيم من لوحة تحكم Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة (اختياري — يُستخدم في مسارات API على الخادم فقط)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (اختياري — بدونها يعمل المدرب الذكي بالقواعد الجاهزة)
OPENAI_API_KEY=

# رابط الموقع (يُستخدم لـ SEO و robots.txt و sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense (اختياري — بدونه لا يُحمَّل سكربت الإعلانات ولا تظهر الوحدات)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# بريد التواصل الرسمي (اختياري — يظهر في صفحة التواصل ويُستخدم في إرسال النموذج)
NEXT_PUBLIC_CONTACT_EMAIL=